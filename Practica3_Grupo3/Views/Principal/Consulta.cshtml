@model List<Practica3_Grupo3.Models.PrincipalModel>
@{
    Layout = "~/Views/Shared/_LayoutInterno.cshtml";
}

<h4 class="fw-bold mb-4">Consulta de Compras</h4>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-info text-center">@ViewBag.Mensaje</div>
}

<div class="card shadow-sm border-0 p-3">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-primary">
                <tr>
                    <th>Código</th>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Saldo</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id_Compra</td>
                        <td>@item.Descripcion</td>
                        <td>@item.Precio.ToString("N2")</td>
                        <td>@item.Saldo.ToString("N2")</td>
                        <td>
                            @if (item.Estado == "Pendiente")
                            {
                                <span class="badge bg-warning text-dark">Pendiente</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Cancelado</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
