@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Sistema Pagos</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- CUSTOM CSS -->
    <link href="~/StaticFiles/css/layoutInterno.css" rel="stylesheet" />
</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <h4>Sistema de Pagos</h4>

        <a href="@Url.Action("Index","Home")" class="menu-link">
            <i class="fa fa-home"></i> Inicio
        </a>

        <a href="@Url.Action("Consulta","Principal")" class="menu-link">
            <i class="fa fa-list"></i> Consulta
        </a>

        <a href="@Url.Action("Registro","Abonos")" class="menu-link">
            <i class="fa fa-credit-card"></i> Registro
        </a>
    </div>

    <!-- MAIN CONTENT -->
    <div class="content">

        <!-- NAVBAR SUPERIOR -->
        <nav class="navbar navbar-custom mb-4 shadow-sm">
            <span class="fw-bold">Sistema de Pagos</span>
        </nav>

        <!-- BODY -->
        <div>
            @RenderBody()
        </div>

        <!-- FOOTER -->
        <footer class="text-center small">
            © @DateTime.Now.Year — Practica #3 - Grupo #3 
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
